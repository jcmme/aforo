# AFORO · variables de entorno
# Copia este archivo a `.env` y rellena con tu proyecto de Supabase.
# Si lo dejas vacío, la app arranca en MODO DEMO con datos locales.
#
# Las variables EXPO_PUBLIC_* se exponen al cliente (son la URL y la anon key
# públicas de Supabase, pensadas para usarse con Row-Level Security activado).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
