# AFORO · variables de entorno (app móvil)
# Copia este archivo a `.env`. Sin estas variables, la app corre en MODO DEMO
# con datos locales. Las EXPO_PUBLIC_* se exponen al cliente por diseño y solo
# son seguras con RLS activado.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo para las Edge Functions (NO van en el cliente) ---
# Se configuran como secrets en Supabase:
#   supabase secrets set AFORO_QR_SECRET=<cadena-larga-aleatoria>
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta
# Supabase automáticamente en el entorno de las funciones.
