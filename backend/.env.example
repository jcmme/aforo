PORT=3000

# postgresql://usuario:password@host:puerto/base_de_datos
# En producción (Neon) usa la conexión CON pooler; para correr migraciones
# desde tu máquina, la conexión directa (DATABASE_URL_UNPOOLED en Vercel).
DATABASE_URL=postgresql://aforo:aforo@localhost:5432/aforo

# true en cualquier Postgres administrado (Neon, etc.): activa SSL y deja el
# pool en 1 conexión, necesario en serverless. Vacío/false en local.
DATABASE_SSL=false

# Orígenes permitidos para CORS, separados por comas (la URL del frontend).
# Si se deja vacío, se aceptan todos — solo para desarrollo local.
CORS_ORIGIN=

JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
