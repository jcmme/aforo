{
  "expo": {
    "name": "AFORO",
    "slug": "aforo",
    "version": "0.1.0",
    "scheme": "aforo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B12",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aforo.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aforo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "AFORO usa la cámara para escanear los códigos QR en la puerta y en mesa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AFORO usa tu galería únicamente para adjuntar una foto a tu reseña del lugar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
